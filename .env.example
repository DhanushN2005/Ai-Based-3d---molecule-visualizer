# Copy this file to .env and fill in your values. Never commit .env.

# Required for AI explanations (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Groq model used for explanations
GROQ_MODEL=openai/gpt-oss-20b

# Optional: full path to blender.exe (only if not on PATH or in
# C:\Program Files\Blender Foundation\)
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.4\blender.exe

# Optional: server settings
HOST=127.0.0.1
PORT=5000

# Optional: set to 1 for Flask debug mode (local development only)
FLASK_DEBUG=0

# Optional: set to 1 only when deployed behind a proxy (Render, Hugging Face...)
# so rate limits use the real visitor IP.
# TRUST_PROXY=1

# Required in production: signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If missing, a random key is used and everyone is logged out on every restart.
# SECRET_KEY=

# Optional: database. Default is a SQLite file in DATA_DIR. For data that survives
# redeploys on a host with an ephemeral disk, use a hosted Postgres (Neon, Supabase...).
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional: set to 1 when the site is served over HTTPS so the login cookie is HTTPS-only.
# SESSION_COOKIE_SECURE=1
